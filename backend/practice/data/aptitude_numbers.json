  {"category":"aptitude","topic":"numbers","question":"Find the largest 4-digit number exactly divisible by 88.","options":[{"text":"9944","isCorrect":true},{"text":"9988","isCorrect":false},{"text":"9900","isCorrect":false},{"text":"9856","isCorrect":false}],"correctAnswer":0,"explanation":"9999÷88=113.6. 88×113=9944","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"numbers","question":"If n is an odd number, then n²-1 is always divisible by:","options":[{"text":"4","isCorrect":false},{"text":"8","isCorrect":true},{"text":"6","isCorrect":false},{"text":"12","isCorrect":false}],"correctAnswer":1,"explanation":"n=2k+1, n²-1=(2k+1)²-1=4k²+4k=4k(k+1). Since k(k+1) is always even, 4k(k+1) is divisible by 8.","difficulty":"hard","marks":1},
