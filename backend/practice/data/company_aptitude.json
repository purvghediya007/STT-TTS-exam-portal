  {"category":"aptitude","topic":"Ages","question":"Father is 3 times as old as his son. After 12 years, he will be twice as old. Present ages are:","options":[{"text":"12 and 36","isCorrect":true},{"text":"10 and 30","isCorrect":false},{"text":"15 and 45","isCorrect":false},{"text":"14 and 42","isCorrect":false}],"correctAnswer":0,"explanation":"F=3S, F+12=2(S+12) → 3S+12=2S+24 → S=12, F=36","difficulty":"easy","marks":1,"companies":["TCS","Cognizant","Accenture"]},
  {"category":"aptitude","topic":"Ages","question":"The sum of ages of 5 children born at intervals of 3 years is 50. Age of the youngest child is:","options":[{"text":"2","isCorrect":false},{"text":"4","isCorrect":true},{"text":"6","isCorrect":false},{"text":"8","isCorrect":false}],"correctAnswer":1,"explanation":"Ages: x, x+3, x+6, x+9, x+12. Sum = 5x+30=50, x=4","difficulty":"medium","marks":1,"companies":["Infosys","Wipro"]},
  {"category":"aptitude","topic":"Percentages","question":"Population of a town increases 10% annually. If present population is 22000, population 2 years ago was:","options":[{"text":"18000","isCorrect":false},{"text":"18150","isCorrect":false},{"text":"18182","isCorrect":true},{"text":"20000","isCorrect":false}],"correctAnswer":2,"explanation":"P × 1.1^2 = 22000 → P = 22000/1.21 ≈ 18182","difficulty":"medium","marks":1,"companies":["Accenture","Wipro"]},
  {"category":"aptitude","topic":"Ratio & Proportion","question":"A mixture contains milk and water in ratio 5:1. If 6 litres of water is added, ratio becomes 5:3. Quantity of milk is:","options":[{"text":"12","isCorrect":false},{"text":"15","isCorrect":true},{"text":"18","isCorrect":false},{"text":"20","isCorrect":false}],"correctAnswer":1,"explanation":"5x/(x+6) = 5/3 → 15x = 5x+30 → x=3. Milk = 15L","difficulty":"hard","marks":1,"companies":["Google","Microsoft"]},
  {"category":"aptitude","topic":"Numbers","question":"The sum of three consecutive even numbers is 126. The smallest is:","options":[{"text":"38","isCorrect":false},{"text":"40","isCorrect":true},{"text":"42","isCorrect":false},{"text":"44","isCorrect":false}],"correctAnswer":1,"explanation":"x + x+2 + x+4 = 126 → 3x = 120 → x = 40","difficulty":"easy","marks":1,"companies":["Cognizant","Accenture"]},
  {"category":"aptitude","topic":"Profit & Loss","question":"An article is sold at 5% profit. If CP was 20% less and SP was Rs.100 less, profit would be 10%. The CP is:","options":[{"text":"1000","isCorrect":true},{"text":"1200","isCorrect":false},{"text":"800","isCorrect":false},{"text":"1500","isCorrect":false}],"correctAnswer":0,"explanation":"1.05C - 100 = 1.1×0.8C → 1.05C - 100 = 0.88C → 0.17C = 100 → C ≈ 1000 (approx.)","difficulty":"hard","marks":1,"companies":["Amazon","Google"]},
  {"category":"aptitude","topic":"Simple & Compound Interest","question":"A sum at simple interest becomes 3 times in 20 years. In how many years will it become 7 times?","options":[{"text":"50","isCorrect":false},{"text":"60","isCorrect":true},{"text":"70","isCorrect":false},{"text":"80","isCorrect":false}],"correctAnswer":1,"explanation":"3P in 20 years → SI = 2P in 20 yrs → rate = 10%. For 7P: 6P/10% = 60 years","difficulty":"medium","marks":1,"companies":["TCS","Infosys"]},
  {"category":"aptitude","topic":"Ages","question":"Present ages of X and Y are in ratio 5:6. Seven years from now, ratio will be 6:7. Present age of X is:","options":[{"text":"30","isCorrect":false},{"text":"35","isCorrect":true},{"text":"40","isCorrect":false},{"text":"25","isCorrect":false}],"correctAnswer":1,"explanation":"(5k+7)/(6k+7) = 6/7 → 35k+49 = 36k+42 → k=7. X = 35","difficulty":"medium","marks":1,"companies":["Wipro","Cognizant"]},
  {"category":"aptitude","topic":"Time, Speed & Distance","question":"A car covers 300 km at a certain speed. If the speed was 10 km/hr more, it would take 1 hour less. Original speed is:","options":[{"text":"40 km/hr","isCorrect":false},{"text":"50 km/hr","isCorrect":true},{"text":"60 km/hr","isCorrect":false},{"text":"45 km/hr","isCorrect":false}],"correctAnswer":1,"explanation":"300/S - 300/(S+10) = 1 → solving: S = 50","difficulty":"hard","marks":1,"companies":["Microsoft","Amazon"]},
