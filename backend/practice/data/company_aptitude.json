  {"category":"aptitude","topic":"Simple & Compound Interest","question":"Find CI on Rs.5000 at 10% for 2 years.","options":[{"text":"1000","isCorrect":false},{"text":"1050","isCorrect":true},{"text":"1100","isCorrect":false},{"text":"1025","isCorrect":false}],"correctAnswer":1,"explanation":"CI = 5000(1.1)^2 - 5000 = 6050 - 5000 = 1050","difficulty":"easy","marks":1,"companies":["TCS","Cognizant"]},
  {"category":"aptitude","topic":"Simple & Compound Interest","question":"The difference between CI and SI on Rs.8000 for 2 years at 5% per annum is:","options":[{"text":"10","isCorrect":false},{"text":"15","isCorrect":false},{"text":"20","isCorrect":true},{"text":"25","isCorrect":false}],"correctAnswer":2,"explanation":"Diff = P(r/100)^2 = 8000 × (5/100)^2 = 8000 × 0.0025 = 20","difficulty":"medium","marks":1,"companies":["Infosys","Accenture"]},
