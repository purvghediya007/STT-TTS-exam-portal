  {"category":"aptitude","topic":"Numbers","question":"Find the largest 4-digit number exactly divisible by 88.","options":[{"text":"9944","isCorrect":true},{"text":"9999","isCorrect":false},{"text":"9900","isCorrect":false},{"text":"9988","isCorrect":false}],"correctAnswer":0,"explanation":"9999 ÷ 88 = 113 rem 55. So 9999 - 55 = 9944","difficulty":"medium","marks":1,"companies":["TCS","Wipro"]},
  {"category":"aptitude","topic":"Simple & Compound Interest","question":"At what rate percent per annum will Rs.2000 amount to Rs.2420 in 2 years at compound interest?","options":[{"text":"8%","isCorrect":false},{"text":"9%","isCorrect":false},{"text":"10%","isCorrect":true},{"text":"11%","isCorrect":false}],"correctAnswer":2,"explanation":"2420 = 2000(1+r/100)^2 → (1+r/100)^2 = 1.21 → r = 10%","difficulty":"medium","marks":1,"companies":["Amazon","Cognizant"]},
