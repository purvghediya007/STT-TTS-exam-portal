[
  {"category":"aptitude","topic":"profit_loss","question":"A man buys an article for ₹800 and sells it for ₹1000. His profit % is:","options":[{"text":"20%","isCorrect":false},{"text":"25%","isCorrect":true},{"text":"30%","isCorrect":false},{"text":"15%","isCorrect":false}],"correctAnswer":1,"explanation":"Profit=200. Profit%=200/800×100=25%","difficulty":"easy","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"By selling a watch for ₹720, a man loses 10%. At what price should he sell to gain 10%?","options":[{"text":"₹880","isCorrect":true},{"text":"₹800","isCorrect":false},{"text":"₹900","isCorrect":false},{"text":"₹850","isCorrect":false}],"correctAnswer":0,"explanation":"CP=720/0.9=₹800. For 10% gain: SP=800×1.1=₹880","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A shopkeeper marks goods 30% above CP and gives 10% discount. His profit % is:","options":[{"text":"17%","isCorrect":true},{"text":"20%","isCorrect":false},{"text":"15%","isCorrect":false},{"text":"22%","isCorrect":false}],"correctAnswer":0,"explanation":"MP=1.3×CP. SP=0.9×1.3×CP=1.17×CP. Profit=17%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"CP of 20 articles equals SP of 16 articles. Profit % is:","options":[{"text":"20%","isCorrect":false},{"text":"25%","isCorrect":true},{"text":"30%","isCorrect":false},{"text":"15%","isCorrect":false}],"correctAnswer":1,"explanation":"20×CP=16×SP. SP/CP=20/16=5/4. Profit=1/4=25%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"Two articles sold at ₹900 each. One at 25% profit, other at 25% loss. Net profit or loss %?","options":[{"text":"6.25% loss","isCorrect":true},{"text":"No P/L","isCorrect":false},{"text":"6.25% profit","isCorrect":false},{"text":"5% loss","isCorrect":false}],"correctAnswer":0,"explanation":"Same SP, same% → Loss = x²/100 = 625/100 = 6.25%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A discount of 15% on MP gives a profit of 2% over CP. Ratio of CP to MP is:","options":[{"text":"17:20","isCorrect":true},{"text":"5:6","isCorrect":false},{"text":"3:4","isCorrect":false},{"text":"4:5","isCorrect":false}],"correctAnswer":0,"explanation":"0.85×MP=1.02×CP. CP/MP=0.85/1.02=85/102=5/6. Hmm: 85/102=85/102. Simplify by dividing by... GCD=1. Not 17:20. Let me recheck: 0.85MP=1.02CP → CP/MP=85/102=5/6. So ratio is 5:6.","difficulty":"hard","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A man sells an article at 5% profit. Had he bought for 5% less and sold for ₹1 less, he would have gained 10%. CP is:","options":[{"text":"₹200","isCorrect":true},{"text":"₹150","isCorrect":false},{"text":"₹250","isCorrect":false},{"text":"₹100","isCorrect":false}],"correctAnswer":0,"explanation":"SP=1.05C. New CP=0.95C, New SP=1.05C-1. 1.05C-1=1.1×0.95C=1.045C. 0.005C=1. C=200","difficulty":"hard","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"Successive discounts of 20% and 10% are equivalent to a single discount of:","options":[{"text":"28%","isCorrect":true},{"text":"30%","isCorrect":false},{"text":"25%","isCorrect":false},{"text":"27%","isCorrect":false}],"correctAnswer":0,"explanation":"Single discount = a+b-ab/100 = 20+10-200/100 = 28%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A dealer uses a false weight of 900g instead of 1kg. His gain % is:","options":[{"text":"10%","isCorrect":false},{"text":"11.11%","isCorrect":true},{"text":"9%","isCorrect":false},{"text":"12%","isCorrect":false}],"correctAnswer":1,"explanation":"Gain% = (1000-900)/900 × 100 = 100/900 × 100 = 11.11%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"An article is sold for ₹360 at a loss of 10%. What should be the SP for 15% profit?","options":[{"text":"₹460","isCorrect":true},{"text":"₹420","isCorrect":false},{"text":"₹480","isCorrect":false},{"text":"₹440","isCorrect":false}],"correctAnswer":0,"explanation":"CP=360/0.9=400. For 15% profit: SP=400×1.15=460","difficulty":"easy","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A merchant sold his goods for ₹75 at a profit of 25%. How much did he pay for it?","options":[{"text":"₹55","isCorrect":false},{"text":"₹60","isCorrect":true},{"text":"₹65","isCorrect":false},{"text":"₹50","isCorrect":false}],"correctAnswer":1,"explanation":"CP = SP×100/(100+P%) = 75×100/125 = ₹60","difficulty":"easy","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"If selling price is doubled, the profit triples. Find the profit percentage.","options":[{"text":"100%","isCorrect":true},{"text":"200%","isCorrect":false},{"text":"50%","isCorrect":false},{"text":"150%","isCorrect":false}],"correctAnswer":0,"explanation":"P=SP-CP. New: 3P=2SP-CP. So 3(SP-CP)=2SP-CP. 3SP-3CP=2SP-CP. SP=2CP. P=CP. P%=100%","difficulty":"hard","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A fruit seller buys oranges at ₹5 for 3 and sells at ₹3 for 1. Profit % is:","options":[{"text":"80%","isCorrect":true},{"text":"60%","isCorrect":false},{"text":"50%","isCorrect":false},{"text":"75%","isCorrect":false}],"correctAnswer":0,"explanation":"CP per orange = 5/3. SP per orange = 3. Profit = 3-5/3 = 4/3. Profit% = (4/3)/(5/3)×100 = 80%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"By what % must a shopkeeper increase the price of an article so that after giving a 10% discount, he still makes 8% profit?","options":[{"text":"18%","isCorrect":false},{"text":"20%","isCorrect":true},{"text":"22%","isCorrect":false},{"text":"25%","isCorrect":false}],"correctAnswer":1,"explanation":"0.9×MP=1.08×CP. MP=1.2×CP. Increase=20%","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A man bought a laptop for ₹30000 and sold at ₹27000. Loss % is:","options":[{"text":"8%","isCorrect":false},{"text":"10%","isCorrect":true},{"text":"12%","isCorrect":false},{"text":"15%","isCorrect":false}],"correctAnswer":1,"explanation":"Loss=3000. Loss%=3000/30000×100=10%","difficulty":"easy","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"A trader marks his goods 40% above CP. He allows two successive discounts of 10% and 15%. His net gain or loss % is:","options":[{"text":"7.1% profit","isCorrect":true},{"text":"7.1% loss","isCorrect":false},{"text":"5% profit","isCorrect":false},{"text":"10% loss","isCorrect":false}],"correctAnswer":0,"explanation":"MP=1.4CP. After 10%: 1.26CP. After 15%: 1.26×0.85CP=1.071CP. Profit=7.1%","difficulty":"hard","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"If an article is sold at 80% of its marked price, the merchant makes 20% loss. At what % of MP should it be sold to make no profit no loss?","options":[{"text":"100%","isCorrect":true},{"text":"90%","isCorrect":false},{"text":"95%","isCorrect":false},{"text":"85%","isCorrect":false}],"correctAnswer":0,"explanation":"0.8MP=0.8CP → MP=CP. To get no P/L, sell at CP=MP=100% of MP","difficulty":"medium","marks":1},
  {"category":"aptitude","topic":"profit_loss","question":"Profit on selling 10 candles equals CP of 3 candles. Profit % is:","options":[{"text":"25%","isCorrect":false},{"text":"30%","isCorrect":true},{"text":"33.33%","isCorrect":false},{"text":"20%","isCorrect":false}],"correctAnswer":1,"explanation":"10SP-10CP=3CP. 10SP=13CP. SP=1.3CP. Profit=30%","difficulty":"medium","marks":1},
