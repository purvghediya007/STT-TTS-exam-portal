# Server
PORT=5000

# MongoDB connection
MONGO_URI=your-mongo-uri-here

# JWT secret
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=1h
JWT_RESET_SECRET=your-jwt-reset-secret-here

#captcha
CAPTCHA_EXPIRES_MS=300000

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Optional
NODE_ENV=development

MAIL_USER=your-mail-user-here

MAIL_PASS=your-mail-pass-here

FRONTEND_URL=http://localhost:5173




# =========================
# Backend Environment Variables
# =========================

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Hugging Face (DO NOT PUT REAL TOKEN)
HF_TOKEN=your_huggingface_token_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stt_tts_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Other
DEBUG=true
FRONTEND_URL=http://localhost:5173

# ===================== AWS S3 Configuration (Audio Storage) =====================
# Get these credentials from AWS IAM Console
# 1. Create IAM user with S3 access
# 2. Generate access key and secret key
# 3. Create S3 bucket for audio files
AWS_S3_ACCESS_KEY_ID=your_access_key_id_here
AWS_S3_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET_NAME=exam-portal-audio
AWS_S3_REGION=us-east-1

UPSTASH_REDIS_REST_URL=https://central-camel-105990.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAZ4GAAIgcDE1MjYxOTI1OTg2MmY0MmNhYWY5Mzc0YTVjMWExM2EwZQ